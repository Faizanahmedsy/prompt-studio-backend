# ── App ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=Prompt Studio API
ENVIRONMENT=development
APP_DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PUBLIC_API_BASE_URL=http://localhost:8010
# Where the Next.js app lives. Used to build links inside invite / reset emails.
FRONTEND_BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Credentials mirror the IntelliWealth stack so one set of dev creds covers both.
# The database itself is separate (prompt_studio) on its own container/port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_USER=intelliwealth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prompt_studio
DB_ECHO=false
# Host port published by the db container (container side stays 5432).
DB_HOST_PORT=5442

# ── Redis ────────────────────────────────────────────────────────────────────
# Only used to fan collaboration messages out across API workers. With it absent
# the app still runs — a single worker broadcasts in-process.
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_HOST_PORT=6382

# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=30
INVITE_TOKEN_EXPIRE_DAYS=14
# Lock an account after this many consecutive failures, for this long.
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ── Seeded accounts (created by `python -m app.seed`) ────────────────────────
SUPERADMIN_EMAIL=faizan@promptstudio.app
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Faizan Saiyed

# ── CORS (JSON array) ────────────────────────────────────────────────────────
# Exact origins, including the port. A missing entry looks like a network
# error in the browser three layers away from the real cause.
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]
# For origins whose hostname is not known ahead of time — Vercel gives every
# preview deployment its own. Anchor it to YOUR project, not to the platform:
# `^https://.*\.vercel\.app$` trusts every site anyone has ever deployed there.
# BACKEND_CORS_ORIGIN_REGEX=^https://your-app(-[a-z0-9-]+)?\.vercel\.app$

# ── Outbound mail ────────────────────────────────────────────────────────────
# EMAIL_TRANSPORT is one of: console | resend | smtp
#
# console prints the message to the log instead of sending, so invites and
# password resets are testable with no mail account configured. Never use it in
# production: it writes live reset tokens into the container log.
#
# resend posts to Resend's HTTP API. This is the one to use on Render, where
# outbound SMTP is not dependably open.
EMAIL_TRANSPORT=console

# Resend --------------------------------------------------------------------
# MAIL_FROM must be on a domain verified in the Resend dashboard. Until one is
# verified, Resend only accepts `onboarding@resend.dev` as the sender, and only
# delivers to the address that owns the Resend account.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_TIMEOUT_SECONDS=10

# SMTP ----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Prompt Studio <no-reply@promptstudio.app>
SMTP_TIMEOUT_SECONDS=10

# ── Rate limits ──────────────────────────────────────────────────────────────
# "<requests>/<seconds>", per caller IP. Account lockout protects one account;
# these protect against password spraying, registration floods and reset floods
# (where the thing being attacked is somebody else's inbox). Turn the whole
# thing off if the deployment sits behind one shared NAT and the limits would
# lock a whole office out at 09:00.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SIGN_IN=20/300
RATE_LIMIT_REGISTER=10/3600
RATE_LIMIT_RESET=5/3600

# ── Collaboration ────────────────────────────────────────────────────────────
# Seconds a websocket may stay silent before the server pings it.
WS_HEARTBEAT_SECONDS=25
# Snapshots kept per project (oldest pruned beyond this).
PROJECT_VERSION_LIMIT=50
